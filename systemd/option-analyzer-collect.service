[Unit]
Description=Option Analyzer — daily stock snapshot collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Adjust these paths to match your installation
WorkingDirectory=/home/pi/proj/option-analyzer
ExecStart=/home/pi/proj/option-analyzer/.venv/bin/python \
    /home/pi/proj/option-analyzer/scripts/collect_snapshots.py
ExecStart=/home/pi/proj/option-analyzer/.venv/bin/python \
    /home/pi/proj/option-analyzer/scripts/compute_signals.py

# Load IBKR credentials and settings from .env
EnvironmentFile=/home/pi/proj/option-analyzer/.env

# Output goes to journald — view with: journalctl -u option-analyzer-collect
StandardOutput=journal
StandardError=journal

# Give it up to 30 minutes (800 stocks × ~2 req each at 10/s ≈ 3 min, with headroom)
TimeoutStartSec=1800

# Restart on failure (e.g. transient IBKR gateway hiccup)
Restart=on-failure
RestartSec=60
StartLimitBurst=3
StartLimitIntervalSec=300

[Install]
WantedBy=multi-user.target
